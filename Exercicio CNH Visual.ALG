Algoritmo "CNH"

Var
   A, N, Idade: Inteiro


Inicio
      Escreva( "Ano atual: " )
      Leia (A)
      Escreva ( "Ano de nascimento ")
      Leia (N)
      Idade <- A - N
      Se (Idade >= 18 ) então
      Escreva (" Você tem " ,Idade , " anos,pode tirar sua CNH ")
      Senão
      EscrevaL (" Você tem ", Idade , " não pode tirar CNH ")
      FimSe

      


Fimalgoritmo