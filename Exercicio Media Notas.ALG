Algoritmo "Escola Carrom"

Var
Nota1, Nota2, Media: Real



Inicio
      Escreva (" Primeira nota: ")
      Leia (Nota1)
      Escreva (" Segunda nota: ")
      Leia (Nota2)
      Media <- (Nota1 + Nota2) /2
      Se (media >= 7) então
      Escreva (" Média: ", media)
      Escreval(" Aluno Aprovado ")
      Senao
      Escreval (" Média: ", media)
      Escreval (" Aluno reprovado ")
      FimSe



Fimalgoritmo